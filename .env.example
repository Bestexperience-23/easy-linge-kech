# ========================================================
# CONFIGURATION DE L'ENVIRONNEMENT (EXEMPLE)
# Copiez ce fichier vers .env et renseignez vos clés réelles
# ========================================================

# Configuration Serveur
PORT=5050
NODE_ENV=development

# WhatsApp Cloud API (Meta Graph API)
META_VERIFY_TOKEN=votre_token_verification_webhook
META_GRAPH_URL=https://graph.facebook.com/v21.0

# Moteur d'Intelligence Artificielle (Google Gemini)
GEMINI_API_KEY=votre_cle_api_gemini_ici

# Base de Données (PostgreSQL)
DATABASE_URL=postgresql://votre_utilisateur:votre_mot_de_passe@localhost:5432/votre_base_de_donnees?schema=public

# Sécurité & Authentification Administrateur
JWT_SECRET=votre_jwt_secret_securise_ici
ADMIN_USERNAME=votre_nom_utilisateur_admin
ADMIN_PASSWORD=votre_mot_de_passe_admin
